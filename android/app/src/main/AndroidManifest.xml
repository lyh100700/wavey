<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!--
          다른 화면으로 나가도 상태바에 Wavey가 남아 있게 해 주는 부분.
          알림의 ⏮ ⏯ ⏭ 버튼을 눌렀을 때 앱으로 전달하는 수신기와,
          음악을 계속 틀어 두는 서비스다.
        -->
        <receiver
            android:name="io.capawesome.capacitorjs.plugins.foregroundservice.NotificationActionBroadcastReceiver"
            android:exported="false" />
        <service
            android:name="io.capawesome.capacitorjs.plugins.foregroundservice.AndroidForegroundService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 앱을 벗어나도 음악을 계속 틀기 위한 권한 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 안드로이드 13부터는 알림을 띄우려면 사용자 허락이 필요하다 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      새 버전을 직접 내려받아 설치하기 위한 권한.
      실제로 설치할 때는 "이 앱이 앱을 설치하도록 허용" 스위치를 사용자가
      설정 화면에서 한 번 켜 줘야 한다 (앱이 마음대로 켤 수 없는 종류다).
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      기본 벨소리·알림음·알람음을 바꾸기 위한 권한.

      이걸 적어 두지 않으면 폰 설정의 "시스템 설정 변경" 목록에 이 앱이 아예
      나타나지 않는다. 사용자가 켜 주고 싶어도 켤 방법이 없고,
      Settings.System.canWrite()는 언제나 거짓을 돌려준다.

      권한을 쓰는 자바 코드만 만들고 여기에 적는 것을 빠뜨려서, 벨소리가
      폴더에는 들어가도 기본 소리로는 지정되지 않았다.
    -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!--
      곡을 벨소리 폴더에 넣기 위한 권한.
      안드로이드 10(API 29)부터는 필요 없어져서 그 이하에서만 요청한다.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
</manifest>
