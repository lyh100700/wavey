{
  "folders": [
    {
      "name": "🌊 Wavey",
      "path": "."
    }
  ],
  "settings": {
    // ── 검색·탐색에서 걸리적거리는 것들 감추기 ──────────────────
    // 이 폴더들은 사람이 쓴 코드가 아니라 도구가 만들어 낸 결과물이다.
    // 켜 두면 검색할 때마다 수만 개 파일이 딸려 나와 원하는 걸 못 찾는다.
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/dist-ssr": true,
      "**/package-lock.json": true,
      "android/build": true,
      "android/.gradle": true,
      "android/app/build": true,
      "android/capacitor-cordova-android-plugins": true,
      "android/app/src/main/assets/public": true
    },

    // 파일 변경 감시에서도 빼 준다 (배터리와 CPU를 아낀다)
    "files.watcherExclude": {
      "**/node_modules/**": true,
      "**/dist/**": true,
      "**/android/build/**": true,
      "**/android/.gradle/**": true,
      "**/android/app/build/**": true
    },

    // ── 편집 ────────────────────────────────────────────────────
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "editor.tabSize": 2,
    "editor.rulers": [100],
    "editor.linkedEditing": true,

    // ── Tailwind ────────────────────────────────────────────────
    // Tailwind 4는 설정 파일 없이 CSS 안에서 테마를 정의한다.
    // 확장이 그 파일을 찾아보게 알려 준다.
    "tailwindCSS.experimental.configFile": "src/index.css",
    "css.lint.unknownAtRules": "ignore",

    // ── 이 프로젝트만의 사정 ────────────────────────────────────
    // Node를 사용자 폴더에 풀어 넣었으므로 터미널이 그 경로를 알아야 한다.
    "terminal.integrated.env.osx": {
      "PATH": "${env:HOME}/.local/node/bin:${env:PATH}"
    }
  },

  "extensions": {
    "recommendations": [
      "bradlc.vscode-tailwindcss",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode"
    ]
  },

  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "개발 서버 켜기",
        "type": "shell",
        "command": "npm run dev",
        "problemMatcher": [],
        "presentation": { "reveal": "always", "panel": "dedicated" },
        "runOptions": { "instanceLimit": 1 }
      },
      {
        "label": "빌드",
        "type": "shell",
        "command": "npm run build",
        "problemMatcher": [],
        "group": "build"
      },
      {
        "label": "테스트",
        "type": "shell",
        "command": "npm test",
        "problemMatcher": [],
        "group": { "kind": "test", "isDefault": true }
      },
      {
        "label": "아이콘·스플래시 다시 만들기",
        "type": "shell",
        "command": "node scripts/generate-assets.mjs",
        "problemMatcher": []
      },
      {
        "label": "안드로이드로 옮기기 (빌드 + 복사)",
        "type": "shell",
        "command": "npm run build && npx cap sync android",
        "problemMatcher": []
      }
    ]
  }
}
